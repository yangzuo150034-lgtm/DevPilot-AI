# Copy to .env locally. Never commit real secrets. Defaults work without this file.
DEVPILOT_OPENAI_API_KEY=
DEVPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
DEVPILOT_MODEL=gpt-4.1-mini
# Optional: configure both current per-million-token prices to estimate cost.
# DEVPILOT_INPUT_PRICE_PER_MILLION=...
# DEVPILOT_OUTPUT_PRICE_PER_MILLION=...
DEVPILOT_EMBEDDING_PROVIDER=hash
DEVPILOT_EMBEDDING_MODEL=text-embedding-3-small
DEVPILOT_GITHUB_TOKEN=
DEVPILOT_API_TOKEN=
DEVPILOT_SANDBOX_ENABLED=false
DEVPILOT_SANDBOX_IMAGE=python:3.12-slim
# Only for Compose. Set your own password/token before starting Compose.
DEVPILOT_POSTGRES_PASSWORD=
# Optional tracing exports code/prompts to your own LangSmith project when explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devpilot-ai
